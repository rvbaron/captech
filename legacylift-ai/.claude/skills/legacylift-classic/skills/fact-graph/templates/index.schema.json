{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://legacylift.ai/schemas/index.json",
  "title": "Fact Graph Index",
  "description": "Master index for the fact graph with metadata and pack references",
  "type": "object",
  "required": ["metadata", "statistics", "packs"],
  "properties": {
    "metadata": {
      "type": "object",
      "description": "Metadata about the fact graph generation",
      "required": ["repository", "generated_at", "tool_version", "analysis_scope"],
      "properties": {
        "repository": {
          "type": "string",
          "description": "Name or path of the analyzed repository",
          "minLength": 1
        },
        "generated_at": {
          "type": "string",
          "description": "ISO-8601 timestamp of when the fact graph was generated",
          "format": "date-time"
        },
        "tool_version": {
          "type": "string",
          "description": "Version of the fact-graph skill that generated this",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "analysis_scope": {
          "type": "string",
          "description": "Scope of the analysis",
          "enum": ["full", "partial", "domain-specific"]
        },
        "domains": {
          "type": "array",
          "description": "List of domains analyzed (if domain-specific)",
          "items": {
            "type": "string"
          }
        },
        "excluded_paths": {
          "type": "array",
          "description": "Paths that were excluded from analysis",
          "items": {
            "type": "string"
          }
        },
        "project_type": {
          "type": "string",
          "description": "Detected project type",
          "enum": ["monolith", "microservices", "monorepo", "library", "cli_tool", "web_app", "mobile_app", "unknown"]
        },
        "architecture_pattern": {
          "type": "string",
          "description": "Detected architecture pattern",
          "enum": ["layered", "mvc", "mvvm", "clean", "microservices", "serverless", "event_driven", "cqrs", "unknown"]
        }
      }
    },
    "statistics": {
      "type": "object",
      "description": "High-level statistics about the extracted knowledge",
      "required": ["entity_count", "relation_count", "fact_count", "files_analyzed"],
      "properties": {
        "entity_count": {
          "type": "integer",
          "description": "Total number of entities extracted",
          "minimum": 0
        },
        "relation_count": {
          "type": "integer",
          "description": "Total number of relations extracted",
          "minimum": 0
        },
        "fact_count": {
          "type": "integer",
          "description": "Total number of facts extracted",
          "minimum": 0
        },
        "files_analyzed": {
          "type": "integer",
          "description": "Number of files analyzed",
          "minimum": 0
        },
        "entity_types": {
          "type": "object",
          "description": "Breakdown of entities by type",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "relation_types": {
          "type": "object",
          "description": "Breakdown of relations by type",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "languages": {
          "type": "object",
          "description": "Breakdown of entities by programming language",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "lines_of_code": {
          "type": "object",
          "description": "Lines of code metrics",
          "properties": {
            "total_loc": {
              "type": "integer",
              "description": "Total lines of code across all analyzed files",
              "minimum": 0
            },
            "total_files": {
              "type": "integer",
              "description": "Total number of files counted",
              "minimum": 0
            },
            "by_language": {
              "type": "object",
              "description": "LOC breakdown by language as reported by cloc",
              "additionalProperties": {
                "type": "object",
                "properties": {
                  "files": {
                    "type": "integer",
                    "description": "Number of files in this language"
                  },
                  "blank": {
                    "type": "integer",
                    "description": "Blank lines"
                  },
                  "comment": {
                    "type": "integer",
                    "description": "Comment lines"
                  },
                  "code": {
                    "type": "integer",
                    "description": "Source code lines"
                  },
                  "total": {
                    "type": "integer",
                    "description": "Total physical lines (blank + comment + code)"
                  },
                  "percentage": {
                    "type": "number",
                    "description": "Percentage of total_loc"
                  }
                }
              }
            },
            "methodology": {
              "type": "string",
              "description": "Description of LOC counting methodology used by cloc"
            }
          }
        },
        "fact_predicates": {
          "type": "object",
          "description": "Breakdown of facts by predicate type",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "packs_metadata": {
          "type": "array",
          "description": "Metadata about domain-scoped packs for selective loading",
          "items": {
            "type": "object",
            "required": ["packId", "domain", "files", "entity_count"],
            "properties": {
              "packId": {
                "type": "string",
                "description": "Unique identifier for the pack (e.g., pack:orders, pack:identity)",
                "pattern": "^pack:[a-z0-9]+$"
              },
              "domain": {
                "type": "string",
                "description": "Business domain name (e.g., Orders, LegalEntity, Points)",
                "minLength": 1
              },
              "files": {
                "type": "object",
                "description": "Paths to pack files for this domain",
                "required": ["entities", "relations", "facts"],
                "properties": {
                  "entities": {
                    "type": "string",
                    "description": "Relative path to entities pack file",
                    "pattern": "^packs/[a-z0-9]+\\.entities\\.pack\\.json$"
                  },
                  "relations": {
                    "type": "string",
                    "description": "Relative path to relations pack file",
                    "pattern": "^packs/[a-z0-9]+\\.relations\\.pack\\.json$"
                  },
                  "facts": {
                    "type": "string",
                    "description": "Relative path to facts pack file",
                    "pattern": "^packs/[a-z0-9]+\\.facts\\.pack\\.json$"
                  }
                }
              },
              "entity_count": {
                "type": "integer",
                "description": "Number of entities in this domain pack",
                "minimum": 0
              },
              "keywords": {
                "type": "array",
                "description": "Keywords for pack discovery and search",
                "items": {
                  "type": "string"
                },
                "maxItems": 50
              }
            }
          }
        }
      }
    },
    "packs": {
      "type": "object",
      "description": "Paths to pack files containing the actual data",
      "required": ["entities", "relations", "facts"],
      "properties": {
        "entities": {
          "type": "string",
          "description": "Relative path to entities pack file",
          "pattern": "^packs/.+\\.pack\\.json$"
        },
        "relations": {
          "type": "string",
          "description": "Relative path to relations pack file",
          "pattern": "^packs/.+\\.pack\\.json$"
        },
        "facts": {
          "type": "string",
          "description": "Relative path to facts pack file",
          "pattern": "^packs/.+\\.pack\\.json$"
        }
      }
    },
    "schema_version": {
      "type": "string",
      "description": "Version of the fact graph schema",
      "pattern": "^\\d+\\.\\d+$",
      "default": "1.0"
    }
  }
}