            ]
          }
        ],
        "qualifier_nodes": ["member_access_expression", "qualified_name"],
        "leaf_identifier_nodes": ["identifier"],
        "call_text_fallback": true
      },

      "references": {
        "reference_nodes": ["identifier", "generic_name", "qualified_name", "member_access_expression"],
        "ignore_context_nodes": ["using_directive", "comment", "string_literal"],
        "emit": {
          "identifier_like": true,
          "qualified_like": true
        }
      }
